# Application Settings
APP_NAME=multimodal-rag-system
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Vector Database - Qdrant (Primary)
# For local deployment:
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# For Qdrant Cloud:
QDRANT_URL=https://your-cluster-id.your-region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-api-key-here
QDRANT_COLLECTION=multimodal_docs
QDRANT_VECTOR_SIZE=384
QDRANT_HEALTH_CHECK_TIMEOUT=5
QDRANT_MAX_RETRIES=3

# Vector Database - Milvus (Fallback)
# For local deployment:
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
# MILVUS_USER=
# MILVUS_PASSWORD=
# For Zilliz Cloud:
MILVUS_URI=https://your-cluster-id.serverless.aws-region.cloud.zilliz.com
MILVUS_TOKEN=your-zilliz-token-here
MILVUS_USER=your-cluster-id
MILVUS_PASSWORD=your-password-here
MILVUS_COLLECTION=multimodal_docs
MILVUS_VECTOR_SIZE=384

# MongoDB (Document Storage)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=multimodal_rag
MONGO_COLLECTION_DOCS=documents
MONGO_COLLECTION_CONSENT=consents
MONGO_COLLECTION_AUDIT=audit_logs

# Redis (Cache & Broker)
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=50

# Embedding Model
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDER_BATCH_SIZE=32
EMBEDDER_DEVICE=cpu

# Vision & OCR
VISION_MODEL=openai/clip-vit-base-patch32
OCR_LANGS=eng
OCR_CONFIG=--oem 3 --psm 6
TESSERACT_PATH=/usr/bin/tesseract

# Text Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
CHUNKING_STRATEGY=token-aware

# Retrieval Settings
DEFAULT_TOP_K=5
DENSE_TOP_K=10
SPARSE_TOP_K=10
RERANK_TOP_N=5
ENABLE_RERANKING=true
DEFAULT_RETRIEVAL_STRATEGY=hybrid

# LLM Provider Configuration
# Provider preference order (comma-separated): google_genai,groq,openai,huggingface,fallback
LLM_PROVIDER_PREFERENCE=google_genai,groq,openai,huggingface,fallback
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# LLM API Keys (add your keys here)
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=

# Security & Privacy
JWT_SECRET=change-this-to-a-random-secure-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-encryption-key
FIELD_ENCRYPTION_ENABLED=true

# Data Retention & Compliance
RETENTION_DAYS=90
ENABLE_CONSENT_REQUIREMENT=true
ENABLE_PII_REDACTION=true
AUDIT_LOG_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Observability
SENTRY_DSN=
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Celery (Async Processing)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# TLS/SSL
TLS_ENABLED=false
TLS_CERT_PATH=/certs/cert.pem
TLS_KEY_PATH=/certs/key.pem
