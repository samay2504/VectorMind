{
  "version": 2,
  "name": "vectormind-frontend",
  "builds": [
    {
      "src": "nextjs-frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/nextjs-frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "@vectormind-api-url"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "@vectormind-api-url"
    }
  }
}
